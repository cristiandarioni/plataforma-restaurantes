# Base de datos PostgreSQL (local o Supabase)
DATABASE_URL=postgres://menu:menu@localhost:5432/menu
# "true" en Supabase y otros Postgres gestionados
DATABASE_SSL=false
# Dominio definitivo: los QR impresos apuntan aquí, así que no debe cambiar nunca
PUBLIC_BASE_URL=http://localhost:3000
# Clave del panel del implementador
IMPL_PASSWORD=implementador
# Cadena aleatoria larga para firmar las sesiones (obligatoria en producción)
SESSION_SECRET=
